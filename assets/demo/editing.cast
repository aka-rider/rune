[0.001, "o", "\u001b[38;5;111m╭──────────────────────────────────────────────────────────────────────────────────────────────────╮\u001b[2;1H│\u001b(B\u001b[m\u001b[38;5;223m\u001b[1mwelcome\u001b(B\u001b[m\u001b[38;5;103m.md\u001b[88C\u001b(B\u001b[m\u001b[38;5;111m│\u001b[3;1H│\u001b(B\u001b[m\u001b[38;5;211m\u001b[1m\u001b[7m#\u001b(B\u001b[m\u001b[38;5;211m\u001b[1m Welcome to Rune\u001b[81C\u001b(B\u001b[m\u001b[38;5;111m│\u001b[4;1H│\u001b[98C│\u001b[5;1H│\u001b(B\u001b[m\u001b[38;5;189mRune is a terminal markdown editor that \u001b[39m\u001b[1mprotects your words\u001b(B\u001b[m\u001b[38;5;189m.\u001b[38C\u001b(B\u001b[m\u001b[38;5;111m│\u001b[6;1H│\u001b[98C│\u001b[7;1H│\u001b(B\u001b[m\u001b[38;5;216m\u001b[1m◈ Try it\u001b[90C\u001b(B\u001b[m\u001b[38;5;111m│\u001b[8;1H│\u001b[98C│\u001b[9;1H│\u001b(B\u001b[m\u001b[38;5;151m☐\u001b(B\u001b[m\u001b[38;5;189m toggle the explorer\u001b[77C\u001b(B\u001b[m\u001b[38;5;111m│\u001b[10;1H│\u001b(B\u001b[m\u001b[38;5;151m☑\u001b(B\u001b[m\u001b[38;5;189m open a file\u001b[85C\u001b(B\u001b[m\u001b[38;5;111m│\u001b[11;1H│\u001b(B\u001b[m\u001b[38;5;103m• \u001b[39m\u001b[3mItalic\u001b(B\u001b[m\u001b[38;5;189m, \u001b[39m\u001b[1mbold\u001b(B\u001b[m\u001b[38;5;189m, and \u001b(B\u001b[m\u001b[38;5;117m\u001b[48;5;239mcode\u001b[49m\u001b(B\u001b[m\u001b[38;5;189m render live.\u001b[61C\u001b(B\u001b[m\u001b[38;5;111m│\u001b[12;1H│\u001b[98C│\u001b[13;1H│\u001b(B\u001b[m\u001b[38;5;243m▎\u001b(B\u001b[m\u001b[38;5;189mYour words are safe: every edit lands in the recovery store.\u001b[37C\u001b(B\u001b[m\u001b[38;5;111m│\u001b[14;1H│\u001b[98C│\u001b[15;1H│\u001b[98C│\u001b[16;1H│\u001b[98C│\u001b[17;1H│\u001b[98C│\u001b[18;1H│\u001b[98C│\u001b[19;1H│\u001b[98C│\u001b[20;1H│\u001b[98C│\u001b[21;1H│\u001b[98C│\u001b[22;1H│\u001b[98C│\u001b[23;1H│\u001b[98C│\u001b[24;1H│\u001b[98C│\u001b[25;1H│\u001b[98C│\u001b[26;1H│\u001b[98C│\u001b[27;1H│\u001b[98C│\u001b[28;1H│\u001b[98C│\u001b[29;1H╰── \u001b(B\u001b[m\u001b[38;5