[1.010, "o", "\u001b[3;2H\u001b[38;5;211m\u001b[1m◉\u001b[6C\u001b(B\u001b[m                 \u001b[4;2H\u001b[38;5;211m\u001b[1m\u001b[7m#\u001b(B\u001b[m\u001b[38;5;211m\u001b[1m Welcome to Rune\u001b[5;2H\u001b(B\u001b[m                                                            \u001b[6;2H\u001b[38;5;189mRune is a terminal markdown editor that \u001b[39m\u001b[1mprotects your words\u001b(B\u001b[m\u001b[38;5;189m.\u001b[7;2H\u001b[39m        \u001b[8;2H\u001b[38;5;216m\u001b[1m◈ Try it\u001b[9;2H\u001b(B\u001b[m                     \u001b[10;2H\u001b[38;5;151m☐\u001b[C\u001b(B\u001b[m\u001b[38;5;189mtoggle\u001b[Cthe explorer\u001b[11;2H\u001b(B\u001b[m\u001b[38;5;151m☑\u001b(B\u001b[m\u001b[38;5;189m open a file\u001b[39m                        \u001b[12;2H\u001b[38;5;103m• \u001b[39m\u001b[3mItalic\u001b(B\u001b[m\u001b[38;5;189m, \u001b[39m\u001b[1mbold\u001b(B\u001b[m\u001b[38;5;189m, and \u001b(B\u001b[m\u001b[38;5;117m\u001b[48;5;239mcode\u001b[49m\u001b(B\u001b[m\u001b[38;5;189m render live.\u001b[13;2H\u001b[39m                                                             \u001b[14;2H\u001b[38;5;243m▎\u001b(B\u001b[m\u001b[38;5;189mYour words are safe: every edit lands in the recovery store.\u001b[30;93H\u001b(B\u001b[m\u001b[38;5;183m\u001b[48;5;237m2\u001b[6C1\u001b(B\u001b[m"]
